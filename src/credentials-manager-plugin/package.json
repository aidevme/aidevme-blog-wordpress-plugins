{
  "name": "credentials-manager-plugin",
  "version": "0.0.85",
  "private": true,
  "description": "Build tooling for the Credentials Manager plugin's React-based admin screens.",
  "scripts": {
    "prebuild": "node bin/bump-version.js",
    "build": "wp-scripts build",
    "postbuild": "node bin/package-zip.js",
    "package-zip": "node bin/package-zip.js",
    "start": "wp-scripts start",
    "check-types": "tsc --noEmit",
    "lint-php": "node bin/lint-php.js",
    "build:release": "npm run lint-php && npm run build"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wordpress/scripts": "^35.0.0",
    "adm-zip": "^0.6.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fluentui/react-components": "^9.74.7",
    "@fluentui/react-datepicker-compat": "^0.6.37",
    "@fluentui/react-icons": "^2.0.341"
  }
}
